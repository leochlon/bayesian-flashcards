  const [isPomodoroRunning, setIsPomodoroRunning] = useState(false);
  const [pomodoroInterval, setPomodoroInterval] = useState(null);
  const [isBreakTime, setIsBreakTime] = useState(false);
  const [breakTimer, setBreakTimer] = useState(5 * 60); // 5 minutes in seconds
  const [pomodoroWorkDuration, setPomodoroWorkDuration] = useState(25); // Default work duration in minutes
  const [pomodoroBreakDuration, setPomodoroBreakDuration] = useState(5); // Default break duration in minutes
