#!/bin/bash
cd "$(dirname "$0")"
export PYTHONPATH="$(pwd)/backend"

# Initialize database if needed
if [ ! -z "$DATABASE_URL" ]; then
    echo "Initializing database at: $DATABASE_URL"
    ./python-venv/bin/python -c "
import os
import sys
import sqlite3
from datetime import datetime

def init_database():
    try:
        db_url = os.environ.get('DATABASE_URL', 'sqlite:///flashcards.db')
        if db_url.startswith('sqlite:///'):
            db_path = db_url[10:]
        else:
            db_path = 'flashcards.db'
        
        print(f'Initializing database at: {db_path}')
        os.makedirs(os.path.dirname(db_path) if os.path.dirname(db_path) else '.', exist_ok=True)
        
        conn = sqlite3.connect(db_path)
        cursor = conn.cursor()
        
        # Create tables
        cursor.execute('''CREATE TABLE IF NOT EXISTS user (id INTEGER PRIMARY KEY AUTOINCREMENT, username VARCHAR(80) UNIQUE NOT NULL, global_decay FLOAT DEFAULT 0.01)''')
        cursor.execute('''CREATE TABLE IF NOT EXISTS deck (id INTEGER PRIMARY KEY AUTOINCREMENT, name VARCHAR(120) NOT NULL, user_id INTEGER NOT NULL, created_at DATETIME DEFAULT CURRENT_TIMESTAMP, FOREIGN KEY (user_id) REFERENCES user (id))''')
        cursor.execute('''CREATE TABLE IF NOT EXISTS card (id INTEGER PRIMARY KEY AUTOINCREMENT, front TEXT NOT NULL, back TEXT NOT NULL, deck_id INTEGER NOT NULL, date_added DATETIME DEFAULT CURRENT_TIMESTAMP, is_mature BOOLEAN DEFAULT FALSE, mature_streak INTEGER DEFAULT 0, last_wrong DATETIME, FOREIGN KEY (deck_id) REFERENCES deck (id))''')
        cursor.execute('''CREATE TABLE IF NOT EXISTS review (id INTEGER PRIMARY KEY AUTOINCREMENT, card_id INTEGER NOT NULL, rating INTEGER NOT NULL, timestamp DATETIME DEFAULT CURRENT_TIMESTAMP, interval_minutes INTEGER, FOREIGN KEY (card_id) REFERENCES card (id))''')
        cursor.execute('''CREATE TABLE IF NOT EXISTS user_profile (id INTEGER PRIMARY KEY AUTOINCREMENT, user_id INTEGER NOT NULL, global_decay FLOAT DEFAULT 0.01, FOREIGN KEY (user_id) REFERENCES user (id))''')
        
        # Create default user if not exists
        cursor.execute('SELECT COUNT(*) FROM user WHERE username = ?', ('default',))
        if cursor.fetchone()[0] == 0:
            cursor.execute('INSERT INTO user (username, global_decay) VALUES (?, ?)', ('default', 0.01))
            user_id = cursor.lastrowid
            cursor.execute('INSERT INTO user_profile (user_id, global_decay) VALUES (?, ?)', (user_id, 0.01))
            print('✓ Default user created')
        
        conn.commit()
        conn.close()
        print('✓ Database initialization completed')
        
    except Exception as e:
        print(f'✗ Database initialization failed: {str(e)}')

init_database()
"
fi

./python-venv/bin/python backend/app.py "$@"
