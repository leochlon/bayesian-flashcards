{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "Bayesian Flashcards",
  "version": "0.1.0",
  "identifier": "com.bayesflashcards.app",
  "build": {
    "beforeBuildCommand": "cd frontend && npm run build",
    "beforeDevCommand": "cd frontend && BROWSER=none PORT=3001 npm start",
    "devUrl": "http://localhost:3001",
    "frontendDist": "../frontend/build"
  },
  "app": {
    "security": {
      "csp": null,
      "capabilities": ["main-capability"]
    },
    "windows": [
      {
        "fullscreen": false,
        "height": 600,
        "resizable": true,
        "title": "Bayesian Flashcards",
        "width": 800,
        "minWidth": 400,
        "minHeight": 300
      }
    ]
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": "all",
    "resources": [
      "python-dist/backend/*",
      "python-dist/python-venv/**",
      "python-dist/backend"
    ]
  }
}
