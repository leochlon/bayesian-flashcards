{
  "$schema": "./gen/schemas/desktop-schema.json",
  "productName": "Bayesian Flashcards",
  "version": "0.1.0",
  "identifier": "com.bayesian.flashcards",
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "frontendDist": "../frontend/build",
    "devUrl": "http://localhost:3000"
  },
  "app": {
    "windows": [
      {
        "fullscreen": false,
        "resizable": true,
        "title": "Bayesian Flashcards",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "Education",
    "copyright": "",
    "shortDescription": "Bayesian Flashcards",
    "longDescription": "A flashcard application using Bayesian statistics",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "python-dist/**/*": "./"
    }
  }
}