{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "identifier": "main-capability",
  "description": "Capability for the main application",
  "context": "local",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:path:default",
    "core:app:default",
    "dialog:allow-open",
    "dialog:allow-save", 
    "dialog:allow-message",
    "dialog:allow-confirm",
    "dialog:allow-ask"
  ]
}
